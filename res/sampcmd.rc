#include <winver.h>

// Application icon (generated from the game's samp.png). Explorer/taskbar use the
// numerically lowest icon ID as the app icon.
1 ICON "sampcmd.ico"

// Application manifest (DPI awareness, asInvoker, OS compatibility).
// 1 == CREATEPROCESS_MANIFEST_RESOURCE_ID, 24 == RT_MANIFEST.
1 24 "sampcmd.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION     2,4,4,0
 PRODUCTVERSION  2,4,4,0
 FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
 FILEFLAGS       0x0L
 FILEOS          VOS__WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "sampcmd"
            VALUE "FileDescription",  "SA:MP launcher (Windows / Wine / Proton)"
            VALUE "FileVersion",      "2.4.4.0"
            VALUE "InternalName",     "sampcmd"
            VALUE "OriginalFilename", "sampcmd.exe"
            VALUE "ProductName",      "sampcmd"
            VALUE "ProductVersion",   "2.4.4.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
